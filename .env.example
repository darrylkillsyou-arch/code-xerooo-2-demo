# Maccall Platform - Environment Configuration Example

# Backend Database (SQLite by default, or PostgreSQL e.g. postgresql://user:pass@localhost:5432/maccall)
DATABASE_URL=sqlite:///./maccall.db

# JWT Authentication
SECRET_KEY=maccall-super-secret-jwt-key-2026-lux-creator-platform
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Message Encryption at Rest (Fernet key - optional; fallback auto-generated if blank)
# To generate a new Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=

# Google Gemini API Key for AI Brief Synthesizer (optional; robust offline keyword fallback included)
GEMINI_API_KEY=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api
