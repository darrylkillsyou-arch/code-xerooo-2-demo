# Database Connection (SQLite local or Supabase PostgreSQL)
# Local SQLite default:
DATABASE_URL=sqlite:///./maccall.db
# Supabase PostgreSQL connection example (Session or Transaction pooler):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or direct connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# JWT Authentication
SECRET_KEY=maccall-super-secret-jwt-key-2026-lux-creator-platform
